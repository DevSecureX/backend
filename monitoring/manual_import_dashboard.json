{
  "dashboard": {
    "id": null,
    "title": "DevSecureX Working Dashboard - IMPORT THIS",
    "description": "Import this dashboard manually if automatic provisioning doesn't work",
    "tags": ["devsecurex", "working", "manual-import"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "✅ Backend Status (Should show UP)",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"devsecurex-backend\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {"text": "DOWN", "color": "red"},
                  "1": {"text": "UP", "color": "green"}
                },
                "type": "value"
              }
            ],
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "📊 System Health Score",
        "type": "stat",
        "targets": [
          {
            "expr": "system_health_score",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 80}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "💾 Database Queries",
        "type": "stat",
        "targets": [
          {
            "expr": "db_active_queries_current",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "⚡ Worker Scaling Target",
        "type": "stat",
        "targets": [
          {
            "expr": "scaling_target_workers",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "📈 Uptime Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "up{job=\"devsecurex-backend\"}",
            "refId": "A",
            "legendFormat": "Backend Status"
          }
        ],
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 4}
      }
    ]
  }
}