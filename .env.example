# DevSecureX Backend Environment Configuration

# Application
APP_ENV=local
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://devsecurex_user:devsecurex_pass@localhost:6544/devsecurex_db

# Redis Configuration  
REDIS_URL=redis://devsecurex-redis:6379

# Security & Auth
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub OAuth Redirect URIs
# For local development (APP_ENV=local)
LOCAL_GITHUB_REDIRECT_URI=http://localhost:8010/auth/github/callback
LOCAL_FRONTEND_GITHUB_REDIRECT_URL=http://localhost:3000/auth/callback

# For production (APP_ENV=production)  
GITHUB_REDIRECT_URI=https://your-production-domain.com/auth/github/callback
FRONTEND_GITHUB_REDIRECT_URL=https://your-frontend-domain.com/auth/callback

# Frontend URL
FRONTEND_URI=http://localhost:3000

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@devsecurex.com

# Payment (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OpenAI (for AI features)
OPENAI_API_KEY=your_openai_api_key

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Scanning Configuration
SCAN_WORKERS=2
WORKER_TIMEOUT=3600
MAX_SCAN_SIZE_MB=100
SCAN_TIMEOUT_SECONDS=1800
ENABLE_BACKGROUND_WORKERS=true

# Queue System Configuration
# Priority: Fortress → Enterprise → Legacy
USE_FORTRESS_QUEUES=true
USE_ENTERPRISE_QUEUES=false
FORTRESS_WORKER_COUNT=2

# Enterprise Queue Configuration (DEPRECATED - Use fortress instead)
# USE_ENTERPRISE_QUEUES=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100