{
  "id": null,
  "uid": "devsecurex-security-scanning",
  "title": "DevSecureX - Security Scanning Performance",
  "description": "Security scan performance, vulnerability detection, and concurrent scan metrics",
  "tags": ["devsecurex", "security", "scanning", "vulnerabilities"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Active Security Scans",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(active_scans_current)",
          "refId": "A",
          "legendFormat": "Active Scans",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 25}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Scans Completed (24h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(security_scans_total{status=\"success\"}[24h])",
          "refId": "A",
          "legendFormat": "Completed Scans",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "green", "value": 50}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "Vulnerabilities Found (24h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(vulnerabilities_found_total[24h])",
          "refId": "A",
          "legendFormat": "Vulnerabilities",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "title": "Scan Success Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(security_scans_total{status=\"success\"}[1h]) / rate(security_scans_total[1h]) * 100",
          "refId": "A",
          "legendFormat": "Success Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 90},
              {"color": "green", "value": 95}
            ]
          },
          "min": 0,
          "max": 100
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5,
      "title": "Scan Duration by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(scan_duration_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "p50 - {{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "histogram_quantile(0.95, rate(scan_duration_seconds_bucket[5m]))",
          "refId": "B",
          "legendFormat": "p95 - {{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "id": 6,
      "title": "Scan Rate by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(security_scans_total[5m])",
          "refId": "A",
          "legendFormat": "{{scan_type}} - {{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "scanps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "id": 7,
      "title": "Vulnerabilities by Severity",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (severity) (increase(vulnerabilities_found_total[24h]))",
          "refId": "A",
          "legendFormat": "{{severity}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "mappings": [
            {
              "options": {
                "critical": {
                  "color": "red"
                },
                "high": {
                  "color": "orange"
                },
                "medium": {
                  "color": "yellow"
                },
                "low": {
                  "color": "green"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "pieType": "pie",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": []
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "id": 8,
      "title": "Files Scanned Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(files_scanned_total[5m])",
          "refId": "A",
          "legendFormat": "{{file_type}} - {{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "fps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    }
  ]
}