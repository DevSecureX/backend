{
  "id": null,
  "uid": "devsecurex-database-performance",
  "title": "DevSecureX - Database Performance (Phase 1)",
  "description": "Database connection pools, query performance, and Phase 1 optimization metrics",
  "tags": ["devsecurex", "database", "performance", "phase-1"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Database Connection Pool Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "db_pool_size_total",
          "refId": "A",
          "legendFormat": "Pool Size - {{pool_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "db_pool_checked_out_connections",
          "refId": "B",
          "legendFormat": "Checked Out - {{pool_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "db_pool_overflow_connections",
          "refId": "C",
          "legendFormat": "Overflow - {{pool_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Connection Pool Utilization %",
      "type": "stat",
      "targets": [
        {
          "expr": "db_pool_checked_out_connections / db_pool_size_total * 100",
          "refId": "A",
          "legendFormat": "{{pool_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Database Query Duration Percentiles",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(db_query_duration_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m]))",
          "refId": "B",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "histogram_quantile(0.99, rate(db_query_duration_seconds_bucket[5m]))",
          "refId": "C",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Query Rate by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(db_queries_total[5m])",
          "refId": "A",
          "legendFormat": "{{query_type}} - {{table}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "qps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "title": "Database Transaction Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(db_transactions_total[5m])",
          "refId": "A",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "tps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "title": "Active Database Queries",
      "type": "timeseries",
      "targets": [
        {
          "expr": "db_active_queries_current",
          "refId": "A",
          "legendFormat": "Active Queries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    }
  ]
}