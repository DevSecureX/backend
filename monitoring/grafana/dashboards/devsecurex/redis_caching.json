{
  "id": null,
  "uid": "devsecurex-redis-caching",
  "title": "DevSecureX - Redis & Caching (Phase 2)",
  "description": "Redis performance, cache hit rates, and Phase 2 multi-level cache metrics",
  "tags": ["devsecurex", "redis", "caching", "performance", "phase-2"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "cache_hit_rate_percentage",
          "refId": "A",
          "legendFormat": "{{cache_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "green", "value": 90}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Cache Operations Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(cache_operations_total[5m])",
          "refId": "A",
          "legendFormat": "{{cache_type}} - {{operation}} - {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        }
      },
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "Redis Connection Pools",
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_pool_size_total",
          "refId": "A",
          "legendFormat": "{{pool_name}} - {{pool_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Cache Operation Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(cache_operation_duration_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "histogram_quantile(0.95, rate(cache_operation_duration_seconds_bucket[5m]))",
          "refId": "B",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "histogram_quantile(0.99, rate(cache_operation_duration_seconds_bucket[5m]))",
          "refId": "C",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "title": "L1 Cache Metrics",
      "type": "timeseries",
      "targets": [
        {
          "expr": "l1_cache_entries_current",
          "refId": "A",
          "legendFormat": "{{cache_name}} - Entries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "l1_cache_memory_usage_bytes",
          "refId": "B",
          "legendFormat": "{{cache_name}} - Memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "graph": false,
              "legend": false,
              "tooltip": false,
              "vis": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "title": "L2 Cache Metrics",
      "type": "timeseries",
      "targets": [
        {
          "expr": "l2_cache_entries_current",
          "refId": "A",
          "legendFormat": "{{cache_name}} - Entries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        },
        {
          "expr": "l2_cache_memory_usage_bytes",
          "refId": "B",
          "legendFormat": "{{cache_name}} - Memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-uid"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    }
  ]
}